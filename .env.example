APP_ENV=development            # development | production
MOCK_MODE=true                 # true 라고 적었을 때만 결제·AI·푸시를 가짜로 처리(시안·테스트용). 운영 서버는 반드시 false
DATABASE_URL=
PUBLIC_WEB_ORIGIN=             # 예) https://www.도메인
API_ORIGIN=
# 첫 관리자: 관리자가 한 명도 없을 때 한 번만 만들어짐(비밀번호 10자 이상). 이후는 관리자 화면 「관리자 계정」에서
ADMIN_EMAIL=
ADMIN_INIT_PASSWORD=
JWT_SECRET=                    # 32자 이상 임의 문자열. 운영(APP_ENV=production)에서는 없으면 서버가 시작하지 않음
# 유료 풀이 AI — READING_AI=live + 키 + 모델 세 가지가 모두 있어야 유료 풀이·사진 상품이 판매됨(아니면 '준비 중')
READING_AI=live
ANTHROPIC_API_KEY=             # 대표님 키 (개발 중엔 이 프로젝트 전용 개발 키)
ANTHROPIC_MODEL=
READING_CONCURRENCY=3          # 동시에 돌리는 AI 호출 수
READING_LONG=on                # on: A4 40~50장 정통 감정서(기본) / off: 9장
# AI_PRICE_IN_PER_M= / AI_PRICE_OUT_PER_M= : 원가 계산용(100만 토큰당 원). 비우면 기본값
# PLAY_STORE_LIVE=1 : Play 스토어 등록 완료 뒤 켬(앱 안내 배너 표시)
# 손금·관상 사진 분석 모델(기본 claude-sonnet-5-5, 1건 약 30원)
PHOTO_AI_MODEL=
# 2세 얼굴보기 — Google Gemini 이미지(aistudio.google.com 에서 키 발급, 1건 2장 약 130~180원)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
RTDN_PUBSUB_AUDIENCE=
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
ADMOB_APP_ID=
ADMOB_BANNER_ID=
ADMOB_INTERSTITIAL_ID=
# 보상형 광고(무료 상세 풀이는 광고를 끝까지 봐야 열림 — 재생 시간은 플랫폼이 정함)
VITE_ADMOB_REWARDED_ID=        # 앱: AdMob 보상형 광고 단위 ID. 비우면 구글 테스트 ID
VITE_GAM_REWARDED_UNIT=        # 웹: Google Ad Manager 보상형 광고 단위 경로(예 /1234567/naman_rewarded). 비우면 웹은 광고 없이 바로 열림(brand.config whenUnavailable)
# 웹 광고: 구글 애드센스 게시자 ID (예: ca-pub-0000000000000000). 비우면 웹 광고 자리만 표시. 앱(Capacitor)에서는 절대 로드하지 않음
ADSENSE_CLIENT_ID=
PG_PROVIDER=payapp             # payapp(대표님 가입 완료) | mock
# PayApp 판매자 관리자 → 설정 → 연동정보 에서 복사. 채팅·코드에 붙이지 말고 여기(서버 환경변수)에만
PAYAPP_USERID=
PAYAPP_LINKKEY=
PAYAPP_LINKVAL=
# 간편 로그인(서버 OAuth) — 콘솔 등록 후 입력. 없으면 MOCK 로그인
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
KAKAO_REST_KEY=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 카카오톡 공유(JavaScript 키, 웹 도메인 등록 필요)
KAKAO_JS_KEY=
# 로컬 개발: DATABASE_URL 이 없으면 내장 PGlite(server/.data/pglite) 사용. DEMO_DATA=true 면 관리자 확인용 데모 데이터
PGLITE_DIR=
DEMO_DATA=false
PORT=8791
