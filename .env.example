APP_ENV=development            # development | production
MOCK_MODE=true                 # true 면 결제·AI·푸시 전부 가짜로 동작 (시안·테스트용)
DATABASE_URL=
PUBLIC_WEB_ORIGIN=             # 예) https://www.도메인
API_ORIGIN=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
JWT_SECRET=
ANTHROPIC_API_KEY=             # 대표님 키 (개발 중엔 이 프로젝트 전용 개발 키)
ANTHROPIC_MODEL=
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
RTDN_PUBSUB_AUDIENCE=
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
ADMOB_APP_ID=
ADMOB_BANNER_ID=
ADMOB_INTERSTITIAL_ID=
PG_PROVIDER=mock               # mock | toss | payapp | ... (결정필요 D3)
PG_CLIENT_KEY=
PG_SECRET_KEY=
# 간편 로그인(서버 OAuth) — 콘솔 등록 후 입력. 없으면 MOCK 로그인
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
KAKAO_REST_KEY=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 카카오톡 공유(JavaScript 키, 웹 도메인 등록 필요)
KAKAO_JS_KEY=
# 로컬 개발: DATABASE_URL 이 없으면 내장 PGlite(server/.data/pglite) 사용. DEMO_DATA=true 면 관리자 확인용 데모 데이터
PGLITE_DIR=
DEMO_DATA=false
PORT=8791
