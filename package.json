{
  "name": "naman-unse",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w web",
    "test": "vitest run",
    "lint": "eslint .",
    "check:independence": "node scripts/check-independence.mjs",
    "check:copy": "node scripts/check-copy-overlap.mjs",
    "make:images": "node scripts/make-images.mjs",
    "db:migrate": "npm run db:migrate -w server",
    "admin:create": "npm run admin:create -w server"
  },
  "devDependencies": {
    "@fullstackfamily/manseryeok": "^1.0.8",
    "@types/node": "^26.6.3",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
